rules_version = '2';

// Security rules for mreddyLiftz cloud sync.
//
// The whole model in one sentence: a signed-in account can read and write documents under its
// own users/{uid} subtree, and nothing else in the database.
//
// Deploy from the Firebase console: Firestore Database -> Rules -> paste -> Publish.
// This file is the source of truth; the console is just where it gets applied.

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything the app stores lives under the signing-in account's own uid.
    match /users/{uid}/{document=**} {
      // request.auth is null when signed out, so this denies anonymous access outright.
      // request.auth.uid == uid is what stops one signed-in account reading another's data:
      // the uid comes from the verified ID token, not from anything the client can set.
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny. Any path not matched above is unreachable, which is what keeps a future
    // feature from accidentally shipping world-readable because nobody wrote a rule for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
