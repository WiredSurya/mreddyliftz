{
  "hosting": {
    "public": "docs",
    "ignore": [
      "**/.*",
      "**/*.md",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=600"
          }
        ]
      }
    ]
  }
}
