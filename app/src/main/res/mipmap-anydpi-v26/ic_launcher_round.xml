<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_art" />
    <!--
      Monochrome (themed icons, Android 13+) stays the original dumbbell vector rather than the
      sprite. A themed icon is flattened to a single-colour silhouette, and the pixel art becomes
      an unreadable blob under that treatment — a dumbbell still reads as a dumbbell.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
