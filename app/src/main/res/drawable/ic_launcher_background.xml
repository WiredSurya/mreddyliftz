<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon BACKGROUND layer: flat deep-sea blue, taken from the artwork's own background so
  the foreground sits on it seamlessly and no seam shows at any mask shape.

  Flat on purpose. The foreground is dense pixel art; a gradient or sheen behind it would fight
  the sprite for attention at 48dp, which is the only size that actually matters.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#265068"
        android:pathData="M0,0h108v108h-108z" />
</vector>
