<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: minimalist dumbbell.
  Drawn inside the 66dp safe zone (viewport 108, safe circle ~ 21..87).
  Bar is horizontal; two plate stacks each side; a diagonal shine streak crosses the bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="dumbbell">

        <!-- Center bar -->
        <path android:pathData="M39,51 h30 v6 h-30 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="39" android:startY="51"
                    android:endX="69" android:endY="57"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFB8C2CC" />
                    <item android:offset="0.5" android:color="#FFFFFFFF" />
                    <item android:offset="1.0" android:color="#FFB8C2CC" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left inner plate -->
        <path
            android:fillColor="#FFE8EDF2"
            android:pathData="M31,44 h8 a3,3 0 0 1 3,3 v14 a3,3 0 0 1 -3,3 h-8 a3,3 0 0 1 -3,-3 v-14 a3,3 0 0 1 3,-3 z" />
        <!-- Left outer plate -->
        <path
            android:fillColor="#FFA9B4BF"
            android:pathData="M22,49 h6 a3,3 0 0 1 3,3 v4 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-4 a3,3 0 0 1 3,-3 z" />

        <!-- Right inner plate -->
        <path
            android:fillColor="#FFE8EDF2"
            android:pathData="M69,44 h8 a3,3 0 0 1 3,3 v14 a3,3 0 0 1 -3,3 h-8 a3,3 0 0 1 -3,-3 v-14 a3,3 0 0 1 3,-3 z" />
        <!-- Right outer plate -->
        <path
            android:fillColor="#FFA9B4BF"
            android:pathData="M80,49 h6 a3,3 0 0 1 3,3 v4 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-4 a3,3 0 0 1 3,-3 z" />

        <!-- Shine streak: thin diagonal gleam over the whole dumbbell -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.55"
            android:pathData="M58,34 L64,34 L48,74 L42,74 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.30"
            android:pathData="M69,34 L72,34 L56,74 L53,74 Z" />
    </group>
</vector>
