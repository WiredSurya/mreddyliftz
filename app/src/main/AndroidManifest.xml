<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibration for the set-complete haptic buzz -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Cloud sync. This app went years without INTERNET on purpose, and adding it is a real change
      in what the app can do: it is now capable of sending your training data off the device.
      It only ever does so to YOUR Firestore document, and only once you have signed in — signing
      out and never signing in leaves the app fully functional and entirely local. See PRIVACY.md,
      which was rewritten when this permission was added.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read-only connectivity state, for the offline indicator. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      In-app updates. There is no store behind this app, so nothing would otherwise tell anyone a
      new build exists. This permission only allows ASKING Android to install a package — the user
      still sees and confirms the system install screen every time. Silent installs are not
      possible for a sideloaded app, by design.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".LiftzApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MreddyLiftz">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MreddyLiftz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Grants the system installer read access to the downloaded APK. A raw file:// URI throws
          FileUriExposedException on API 24+, which is why this exists rather than a direct path.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Phase 2 stretch: macro quick-add home screen widget -->
        <receiver
            android:name=".widget.MacroWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/macro_widget_info" />
        </receiver>

    </application>
</manifest>
