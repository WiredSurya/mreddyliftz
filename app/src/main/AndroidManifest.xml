<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibration for the set-complete haptic buzz -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Cloud sync. This app went years without INTERNET on purpose, and adding it is a real change
      in what the app can do: it is now capable of sending your training data off the device.
      It only ever does so to YOUR Firestore document, and only once you have signed in — signing
      out and never signing in leaves the app fully functional and entirely local. See PRIVACY.md,
      which was rewritten when this permission was added.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read-only connectivity state, for the offline indicator. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LiftzApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MreddyLiftz">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MreddyLiftz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 2 stretch: macro quick-add home screen widget -->
        <receiver
            android:name=".widget.MacroWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/macro_widget_info" />
        </receiver>

    </application>
</manifest>
